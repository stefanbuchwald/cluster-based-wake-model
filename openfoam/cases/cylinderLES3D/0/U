FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 0);

boundaryField
{
    inlet    { type fixedValue; value uniform (1 0 1e-6); }
    outlet   { type zeroGradient; }
    walls    { type slip; }
    cylinder { type noSlip; }
    front    { type cyclic; }
    back     { type cyclic; }
}

FoamFile
{
    format          ascii;
    class           dictionary;
    object          controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solver          incompressibleFluid;

application     incompressibleFluid;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         300;

deltaT          0.0005;

adjustTimeStep  yes;

maxCo           0.75;

maxDeltaT       0.01;

writeControl    adjustableRunTime;

writeInterval   0.25;

purgeWrite      0;

runTimeModifiable true;

functions
{
    forceCoeffs
    {
        type            forceCoeffs;
        libs            ( "libforces.so" );
        patches         ( cylinder );
        rho             rhoInf;
        rhoInf          1;
        CofR            ( 0 0 0 );
        dragDir         ( 1 0 0 );
        liftDir         ( 0 1 0 );
        pitchAxis       ( 0 0 1 );
        magUInf         1;
        lRef            1;
        Aref            4;
        writeControl    timeStep;
        writeInterval   1;
        log             false;
    }
}


